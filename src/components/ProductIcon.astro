---
import { Image } from "astro:assets";
import { monogram } from "../lib/monogram";
import type { Product } from "../lib/products";
import styles from "./ProductIcon.module.css";

interface Props {
  product: Product;
  size: number;
}

const { product, size } = Astro.props;
const { id, name, icon } = product.data;
---

<span
  class={styles.icon}
  style={{ "--size": `${size}px` }}
  transition:name={`icon-${id}`}
  data-product-icon
>
  {
    icon ? (
      <Image
        src={icon}
        alt=""
        width={size * 2}
        height={size * 2}
        class={styles.image}
      />
    ) : (
      <span class={styles.monogram} aria-hidden="true">
        {monogram(name)}
      </span>
    )
  }
</span>
