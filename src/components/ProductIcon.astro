---
import type { Product } from "../lib/products";
import styles from "./ProductIcon.module.css";
import ProductIconFace from "./ProductIconFace.astro";

interface Props {
  product: Product;
  size: number;
  /** Shared icons grow between pages. Pass false for one that travels inside something else, like a browser bar. */
  shared?: boolean;
}

const { product, size, shared = true } = Astro.props;
---

{
  shared ? (
    <span
      class={styles.icon}
      style={{ "--size": `${size}px` }}
      transition:name={`icon-${product.id}`}
      data-product-icon
    >
      <ProductIconFace product={product} />
    </span>
  ) : (
    <span
      class={styles.icon}
      style={{ "--size": `${size}px` }}
      data-product-icon
    >
      <ProductIconFace product={product} />
    </span>
  )
}
