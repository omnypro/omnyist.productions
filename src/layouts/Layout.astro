---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import styles from "./Layout.module.css";

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const siteName = "Omnyist Productions";
const {
	title,
	description = "A small collective of four omni-hobbyists building software for an audience of one: ourselves.",
	image = "/og-image.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en" class={styles.html}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<Font cssVariable="--font-geist" preload />

		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#000000" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${siteName} logo`} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />

		<meta name="generator" content={Astro.generator} />

		<ClientRouter />
		<script>
			import "../scripts/reveal-origin";
		</script>
	</head>
	<body class={styles.body}>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--column: 880px;
		--transition-duration: 520ms;
		--transition-ease: cubic-bezier(0.22, 1, 0.36, 1);
	}

	::view-transition-group(*) {
		animation-duration: var(--transition-duration);
		animation-timing-function: var(--transition-ease);
	}

	::view-transition-old(root),
	::view-transition-new(root) {
		animation-duration: var(--transition-duration);
		animation-timing-function: var(--transition-ease);
		mix-blend-mode: normal;
	}

	html[data-astro-transition="forward"]::view-transition-old(root) {
		animation: none;
	}

	html[data-astro-transition="forward"]::view-transition-new(root) {
		animation-name: reveal-open;
	}

	html[data-astro-transition="back"]::view-transition-old(root) {
		animation-name: reveal-close;
		z-index: 2;
	}

	html[data-astro-transition="back"]::view-transition-new(root) {
		animation: none;
	}

	/* Groups that exist on only one page stack above shared ones, so every
	   shared element (the header, the bars) goes above the wallpaper and the
	   window body, which sit just over the page itself. */
	::view-transition-group(*) {
		z-index: 4;
	}

	::view-transition-group(root) {
		z-index: auto;
	}

	::view-transition-group(wall) {
		z-index: 1;
	}

	::view-transition-group(window-body) {
		z-index: 2;
	}

	::view-transition-group(logo) {
		z-index: 5;
	}

	/* Websites: the bar travels, the wallpaper fades, and the window body rises
	   up under the bar (and sinks back into it on the way home). */
	html[data-reveal="bar"][data-astro-transition="forward"]::view-transition-old(root) {
		z-index: 2;
		animation: fade-out calc(var(--transition-duration) * 0.45) ease both;
	}

	html[data-reveal="bar"][data-astro-transition="forward"]::view-transition-new(root) {
		animation: none;
	}

	html[data-reveal="bar"][data-astro-transition="back"]::view-transition-old(root) {
		z-index: auto;
		animation: none;
	}

	html[data-reveal="bar"][data-astro-transition="back"]::view-transition-new(root) {
		animation: fade-in calc(var(--transition-duration) * 0.7) calc(var(--transition-duration) * 0.2) ease both;
	}

	::view-transition-old(wall),
	::view-transition-new(wall),
	::view-transition-old(window-body),
	::view-transition-new(window-body) {
		mix-blend-mode: normal;
		animation-duration: var(--transition-duration);
		animation-timing-function: var(--transition-ease);
		animation-fill-mode: both;
	}

	html[data-astro-transition="forward"]::view-transition-new(wall) {
		animation-name: fade-in;
	}

	html[data-astro-transition="forward"]::view-transition-new(window-body) {
		animation-name: rise;
		animation-delay: calc(var(--transition-duration) * 0.2);
	}

	html[data-astro-transition="back"]::view-transition-old(wall) {
		animation-name: fade-out;
		animation-delay: calc(var(--transition-duration) * 0.2);
	}

	html[data-astro-transition="back"]::view-transition-old(window-body) {
		animation-name: sink;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(56px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	@keyframes sink {
		from {
			opacity: 1;
			transform: none;
		}
		to {
			opacity: 0;
			transform: translateY(56px);
		}
	}

	@keyframes fade-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes fade-out {
		from {
			opacity: 1;
		}
		to {
			opacity: 0;
		}
	}

	@keyframes reveal-open {
		from {
			clip-path: circle(0 at var(--reveal-x) var(--reveal-y));
		}
		to {
			clip-path: circle(var(--reveal-r) at var(--reveal-x) var(--reveal-y));
		}
	}

	@keyframes reveal-close {
		from {
			clip-path: circle(var(--reveal-r) at var(--reveal-x) var(--reveal-y));
		}
		to {
			clip-path: circle(0 at var(--reveal-x) var(--reveal-y));
		}
	}
</style>
