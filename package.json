{
  "name": "omnyist-productions",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "lint": "oxlint --type-aware",
    "fmt": "oxfmt && prettier --write \"src/**/*.astro\"",
