  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "astro": "7.3.8",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.12.3"
  }
}
