---
import { getCollection, getEntry, render } from "astro:content";
import Logo from "../assets/logo.svg";
import Footer from "../components/Footer.astro";
import BrowserBar from "../components/BrowserBar.astro";
import ProductIcon from "../components/ProductIcon.astro";
import Layout from "../layouts/Layout.astro";
import { groupByKind } from "../lib/products";
import styles from "./index.module.css";

const { software, website: websites } = groupByKind(
  await getCollection("products"),
);
const about = await getEntry("about", "home");
if (!about) {
  throw new Error('src/data/about.jsonc must contain an entry with id "home"');
}
const { Content: AboutBody } = await render(about);
---

<Layout title="Omnyist Productions">
  <main class={styles.main}>
    <div class={styles.logo} transition:name="logo">
      <Logo role="img" aria-label="Omnyist Productions" />
    </div>
    <h1 class={styles.title}>
      We build things for ourselves <span class={styles.subtitle}
        >(and hope you find them useful too)</span
      >
    </h1>
    <section aria-labelledby="software">
      <h2 id="software" class={styles.label}>Software</h2>
      <ul class={styles.products}>
        {
          software.map((product) => (
            <li>
              <a class={styles.product} href={`/${product.id}/`}>
                <ProductIcon product={product} size={96} />
                <span class={styles.productName}>{product.data.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
    {
      websites.length > 0 && (
        <section class={styles.websites} aria-labelledby="websites">
          <h2 id="websites" class={styles.label}>
            Websites
          </h2>
          <ul class={styles.sites}>
            {websites.map((product) => (
              <li>
                <a
                  class={styles.site}
                  data-website-bar
                  href={`/${product.id}/`}
                  aria-label={product.data.name}
                >
                  <BrowserBar product={product} />
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
    <section class={styles.about} aria-labelledby="about">
      <h2 id="about" class={styles.label}>About</h2>
      <AboutBody />
    </section>
    <Footer />
  </main>
</Layout>
